# Copy to .env (or export in your shell / hosting provider).
PORT=3001
NODE_ENV=production
# 32+ random chars. Used to encrypt 2FA secrets at rest. If unset, one is generated
# and stored in data/.app_secret (chmod 600). Set it explicitly in production.
APP_SECRET=
# Where the SQLite database lives.
DATA_DIR=./data
# Set to 1 when running behind a single reverse proxy (nginx, Fly, Render, Heroku...)
TRUST_PROXY=0
